{
  "name": "relay-companion-coordinator",
  "private": true,
  "version": "0.1.0",
  "description": "Passes end-to-end encrypted frames between a Relay computer and its linked phones, and serves the companion app.",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit -p .",
    "test": "node --experimental-strip-types --no-warnings --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "wrangler": "^4.154.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "typescript": "~5.8.3"
  }
}
